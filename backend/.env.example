# ---- Server ----
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (first one is used for OAuth redirects)
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/mern_blog

# ---- JWT (use long random strings, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# ---- Security ----
BCRYPT_SALT_ROUNDS=12
# 'lax' works when frontend and API share a site (e.g. localhost:5173 -> localhost:5000).
# Use 'none' (requires HTTPS) if they are on different sites.
COOKIE_SAME_SITE=lax
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=300

# ---- OAuth 2.0 (leave blank to disable a provider) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# ---- First admin (used by `npm run seed:admin`) ----
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
